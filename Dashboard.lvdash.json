{
  "datasets": [
    {
      "name": "0e29d4ea",
      "displayName": "painel1_frota",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(CASE WHEN state = 'inTransit' THEN 1 ELSE 0 END) AS em_transito,\r\n",
        "    SUM(CASE WHEN state = 'charging' THEN 1 ELSE 0 END) AS em_carregamento,\r\n",
        "    SUM(CASE WHEN state IN ('parked','waitingForCharger') THEN 1 ELSE 0 END) AS inativo,\r\n",
        "    SUM(CASE WHEN batteryLevel < 20 THEN 1 ELSE 0 END) AS bateria_critica\r\n",
        "FROM bus_telemetry_raw"
      ]
    },
    {
      "name": "208f2607",
      "displayName": "painel1_estacoes",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(CASE WHEN state = 'available' THEN 1 ELSE 0 END) AS estacoes_disponiveis,\r\n",
        "    SUM(CASE WHEN state = 'occupied' THEN 1 ELSE 0 END) AS estacoes_ocupadas,\r\n",
        "    SUM(CASE WHEN state = 'fault' THEN 1 ELSE 0 END) AS estacoes_avaria,\r\n",
        "    ROUND(SUM(currentPower), 1) AS carga_total_kw,\r\n",
        "    360.0 AS limite_rede_kw\r\n",
        "FROM charger_telemetry_raw"
      ]
    },
    {
      "name": "painel2_autocarros",
      "displayName": "painel2_autocarros",
      "queryLines": [
        "SELECT\n",
        "  device_id AS Identificador,\n",
        "  currentStop AS Paragem_atual,\n",
        "  ROUND(batteryLevel, 1) AS Bateria_pct,\n",
        "  ROUND(batteryKwh, 1) AS Bateria_kWh,\n",
        "  ROUND(batteryTemperature, 1) AS Temperatura,\n",
        "  nextStop AS Proxima_paragem,\n",
        "  state AS Estado,\n",
        "  ROUND(batteryKwh / 1.2, 1) AS Autonomia_km,\n",
        "  CASE\n",
        "    WHEN\n",
        "      batteryLevel < 20\n",
        "      OR batteryTemperature > 35\n",
        "    THEN\n",
        "      'CRITICO'\n",
        "    WHEN batteryLevel BETWEEN 20 AND 30 THEN 'ATENCAO'\n",
        "    ELSE 'NORMAL'\n",
        "  END AS cor_linha\n",
        "FROM\n",
        "  bus_telemetry\n",
        "ORDER BY\n",
        "  device_id"
      ],
      "catalog": "dbw_stcp_bus",
      "schema": "default"
    },
    {
      "name": "painel3_estacoes",
      "displayName": "painel3_estacoes",
      "queryLines": [
        "SELECT\n",
        "  device_id AS Identificador,\n",
        "  state AS Estado,\n",
        "  connectedBus AS Autocarro_em_carga,\n",
        "  ROUND(currentPower, 1) AS Potencia_kW,\n",
        "  ROUND(chargerTemperature, 1) AS Temperatura,\n",
        "  CASE\n",
        "    WHEN state = 'fault' THEN 'EM AVARIA — requer atenção'\n",
        "    ELSE ''\n",
        "  END AS alerta\n",
        "FROM\n",
        "  charger_telemetry\n",
        "ORDER BY\n",
        "  device_id"
      ],
      "catalog": "dbw_stcp_bus",
      "schema": "default"
    },
    {
      "name": "painel4_recomendacoes",
      "displayName": "painel4_recomendacoes",
      "queryLines": [
        "SELECT\n",
        "  device_id AS autocarro,\n",
        "  nome_rota,\n",
        "  prioridade,\n",
        "  ROUND(soc_actual, 1) AS bateria_actual_pct,\n",
        "  ROUND(delta_soc, 1) AS deficit_pct,\n",
        "  score_total,\n",
        "  COALESCE(estacao_id, 'EM FILA') AS estacao,\n",
        "  ROUND(potencia_final_kw, 0) AS potencia_kw,\n",
        "  ROUND(tempo_carga_min, 0) AS tempo_estimado_min,\n",
        "  paragens_restantes,\n",
        "  ROUND(soc_previsto_chegada, 1) AS soc_previsto_deposito_pct,\n",
        "  CASE\n",
        "    WHEN\n",
        "      estacao_id IS NOT NULL\n",
        "      AND potencia_final_kw > 0\n",
        "    THEN\n",
        "      CONCAT('CARREGAR AGORA em ', estacao_id, ' a ', ROUND(potencia_final_kw, 0), ' kW')\n",
        "    WHEN estacao_id IS NULL THEN 'AGUARDAR — sem estação disponível'\n",
        "    ELSE 'VERIFICAR'\n",
        "  END AS acao,\n",
        "  CONCAT(\n",
        "    CASE\n",
        "      WHEN score_total >= 160 THEN 'EMERGÊNCIA'\n",
        "      WHEN score_total >= 100 THEN 'URGENTE'\n",
        "      ELSE 'PRIORITÁRIO'\n",
        "    END,\n",
        "    ' | ',\n",
        "    'Défice: ',\n",
        "    ROUND(delta_soc, 1),\n",
        "    '% | ',\n",
        "    'Score: ',\n",
        "    score_total,\n",
        "    ' pts | ',\n",
        "    nome_rota\n",
        "  ) AS razao\n",
        "FROM\n",
        "  decisoes_carregamento\n",
        "ORDER BY\n",
        "  score_total DESC"
      ]
    },
    {
      "name": "painel1_carga_rede",
      "displayName": "painel1_carga_rede",
      "queryLines": [
        "SELECT\n",
        "  'Carga Total (kW)' AS metrica,\n",
        "  ROUND(SUM(currentPower), 1) AS valor_kw\n",
        "FROM\n",
        "  charger_telemetry_raw\n",
        "UNION ALL\n",
        "SELECT\n",
        "  'Limite Rede (kW)',\n",
        "  360.0\n",
        "FROM\n",
        "  charger_telemetry_raw\n",
        "LIMIT 1"
      ]
    }
  ],
